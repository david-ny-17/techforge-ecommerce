# Copia este archivo a backend\.env y rellena lo minimo:
#   copy backend\.env.example backend\.env
# Nota: si una variable ya existe en Windows, la del sistema gana sobre este archivo.

# ===== Django =====

# Desarrollo local: True. En produccion: False (o no definirla).
DJANGO_DEBUG=True

# Obligatoria cuando DJANGO_DEBUG no es True. Con DEBUG=True puedes dejarla
# vacia y se usa una clave de desarrollo. Para generar una nueva:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Pegala entre comillas simples, por ejemplo: DJANGO_SECRET_KEY='tu-clave'
DJANGO_SECRET_KEY=

# Opcionales (separados por comas, sin espacios). Si se omiten, se usan estos valores:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# En produccion con HTTPS, por ejemplo: DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=

# ===== Inteligencia artificial (Smart Builder) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ===== Stripe (pagos, modo de prueba) =====
# Clave secreta de prueba del panel de Stripe (empieza con sk_test_)
STRIPE_SECRET_KEY=